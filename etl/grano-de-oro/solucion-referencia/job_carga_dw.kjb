    </entry>
    <entry>
      <name>Crear carpeta salida</name>
      <description>Carpeta del almacén SQLite, los rechazos y los KPI.</description>
      <type>CREATE_FOLDER</type>
      <attributes/>
      <foldername>${Internal.Entry.Current.Directory}/../salida</foldername>
      <fail_of_folder_exists>N</fail_of_folder_exists>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>416</xloc>
      <yloc>128</yloc>
