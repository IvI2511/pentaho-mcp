<?xml version="1.0" encoding="UTF-8"?>
<job>
  <name>job_carga_dw</name>
  <description>Orquesta la carga del almacén: dimensiones, hechos y KPI</description>
  <extended_description>Comprueba que existen los ficheros de entrada, crea la carpeta salida/ y el modelo estrella en SQLite, carga las tres dimensiones, después los hechos (que buscan las claves subrogadas en ellas) y por último los KPI. Si cualquier entrada falla, el hop rojo escribe el error en el log y aborta el job, que termina con código de salida distinto de 0.</extended_description>
  <job_version/>
  <job_status>0</job_status>
  <directory>/</directory>
  <created_user>-</created_user>
  <created_date>2026/10/20 10:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/10/20 10:00:00.000</modified_date>
