  <step>
    <name>Buscar categoría</name>
    <type>StreamLookup</type>
    <description>codigo_producto -&gt; categoría (nulo si no está en el catálogo).</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <from>Estandarizar productos</from>
    <input_sorted>N</input_sorted>
    <preserve_memory>Y</preserve_memory>
    <sorted_list>N</sorted_list>
    <integer_pair>N</integer_pair>
    <lookup>
      <key>
        <name>codigo_producto</name>
        <field>codigo_producto</field>
      </key>
      <value>
        <name>categoria</name>
        <rename>categoria</rename>
        <default/>
