    <type>StringOperations</type>
    <description>Código en mayúsculas; categoría sin espacios y con inicial mayúscula (CAFÉ, café -&gt; Café).</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
