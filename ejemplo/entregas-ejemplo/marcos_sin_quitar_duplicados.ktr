      <schema_name/>
    </partitioning>
    <from>Leer tiendas (JSON)</from>
    <input_sorted>N</input_sorted>
    <preserve_memory>Y</preserve_memory>
    <sorted_list>N</sorted_list>
    <integer_pair>N</integer_pair>
    <lookup>
      <key>
        <name>id_tienda</name>
        <field>id_tienda</field>
      </key>
      <value>
        <name>nombre</name>
        <rename>tienda</rename>
