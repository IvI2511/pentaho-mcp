<?xml version="1.0" encoding="UTF-8"?>
<transformation>
  <info>
    <name>marcos_sin_quitar_duplicados</name>
    <description>KPI de ventas por tienda y categoría, directamente desde los tres ficheros</description>
    <extended_description>Versión en una sola transformación de la ETL de Grano de Oro, para el corrector de ejercicios: lee las ventas (CSV), el catálogo (Excel) y las tiendas (JSON), unifica el precio (coma o punto decimal), quita los duplicados por (id_ticket, linea), descarta las líneas sin tienda, con cantidad no positiva o con un producto que no está en el catálogo, y suma unidades e importe por tienda y categoría. Da la tabla «KPI: ventas por tienda y categoría» de datos/LEEME.md.</extended_description>
    <trans_version/>
    <trans_type>Normal</trans_type>
    <directory>/</directory>
    <parameters>
    </parameters>
    <size_rowset>10000</size_rowset>
    <sleep_time_empty>50</sleep_time_empty>
    <sleep_time_full>50</sleep_time_full>
    <unique_connections>N</unique_connections>
    <feedback_shown>Y</feedback_shown>
    <feedback_size>50000</feedback_size>
    <using_thread_priorities>Y</using_thread_priorities>
    <shared_objects_file/>
    <capture_step_performance>N</capture_step_performance>
    <step_performance_capturing_delay>1000</step_performance_capturing_delay>
    <step_performance_capturing_size_limit>100</step_performance_capturing_size_limit>
    <dependencies>
    </dependencies>
    <partitionschemas>
    </partitionschemas>
    <slaveservers>
    </slaveservers>
    <clusterschemas>
    </clusterschemas>
    <created_user>-</created_user>
    <created_date>2026/10/21 10:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/10/21 10:00:00.000</modified_date>
    <key_for_session_key/>
    <is_key_private>N</is_key_private>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>Leer ventas (CSV)</from>
      <to>Estandarizar textos</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Estandarizar textos</from>
      <to>Normalizar precio</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Normalizar precio</from>
      <to>Convertir precio a número</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Convertir precio a número</from>
      <to>Buscar tienda</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Leer tiendas (JSON)</from>
      <to>Buscar tienda</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Buscar tienda</from>
      <to>Buscar categoría</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Leer productos (Excel)</from>
      <to>Estandarizar productos</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Estandarizar productos</from>
      <to>Buscar categoría</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Buscar categoría</from>
      <to>¿Línea válida?</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>¿Línea válida?</from>
      <to>Calcular importe</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Calcular importe</from>
      <to>Ordenar por tienda y categoría</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Ordenar por tienda y categoría</from>
      <to>Ventas por tienda y categoría</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Ventas por tienda y categoría</from>
      <to>Redondear importe</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Redondear importe</from>
      <to>Escribir KPI</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <step>
