      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>968</xloc>
      <yloc>32</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>CSV KPI tienda y categoría</name>
    <type>TextFileOutput</type>
    <description>salida/kpi_ventas_tienda_categoria.csv</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
