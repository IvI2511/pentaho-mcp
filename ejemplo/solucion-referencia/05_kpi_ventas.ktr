  <step>
    <name>Totales por tienda</name>
    <type>GroupBy</type>
    <description>Importe total y número de tickets distintos por tienda.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <all_rows>N</all_rows>
    <ignore_aggregate>N</ignore_aggregate>
    <field_ignore/>
    <directory>%%java.io.tmpdir%%</directory>
    <prefix>kpi2</prefix>
    <add_linenr>N</add_linenr>
    <linenr_fieldname/>
    <give_back_row>N</give_back_row>
    <group>
      <field>
        <name>tienda</name>
      </field>
    </group>
    <fields>
      <field>
        <aggregate>importe_sin_redondear</aggregate>
        <subject>importe</subject>
        <type>SUM</type>
        <valuefield/>
      </field>
      <field>
        <aggregate>num_tickets</aggregate>
        <subject>id_ticket</subject>
        <type>COUNT_DISTINCT</type>
        <valuefield/>
      </field>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
