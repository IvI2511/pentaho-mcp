{
  "format": "pentaho-live-exercise-pack/1",
  "id": "ventas-por-producto",
  "title": "Ejercicio 3 - Ventas por producto",
  "language": "es",
  "statement": "enunciado.md",
  "kind": "transformation",
  "solution": "solucion/03_ventas_por_producto.ktr",
  "inputs": ["ventas.csv"],
  "cases": [
    { "id": "visible", "inputs_dir": "datos/visible", "expected": "esperado/visible.csv", "weight": 1 },
    { "id": "oculto", "inputs_dir": "datos/oculto", "expected": "esperado/oculto.csv", "weight": 1, "hidden": true }
  ],
  "output": {
    "capture": "file",
    "step": "Escribir totales",
    "columns": [
      { "name": "producto", "type": "String" },
      { "name": "unidades", "type": "Integer", "format": "0" },
      { "name": "importe_total", "type": "Number", "format": "0.00" },
      { "name": "num_ventas", "type": "Integer", "format": "0" },
      { "name": "importe_medio", "type": "Number", "format": "0.00" },
      { "name": "ultima_venta", "type": "Date", "format": "yyyy-MM-dd" }
    ],
    "expected_csv": { "separator": ";", "enclosure": "\"", "header": true, "encoding": "UTF-8" }
  },
  "compare": {
    "key_columns": ["producto"],
    "ignore_column_order": true,
    "ignore_row_order": true,
    "numeric_tolerance": 0.01,
    "relative_tolerance": 0,
    "trim": true,
    "case_sensitive": true,
    "date_formats": ["yyyy-MM-dd", "dd/MM/yyyy"],
    "strict_format": false,
    "extra_columns": "warn",
    "max_examples": 5
  },
  "rules": [
    { "id": "usa_group_by", "type": "must_use", "steps": ["GroupBy", "MemoryGroupBy"], "label": "Usa un Group by (o Memory group by)" },
    { "id": "sin_codigo", "type": "must_not_use", "steps": ["ScriptValueMod", "UserDefinedJavaClass", "Janino"], "label": "No usa JavaScript ni Java" },
    { "id": "max_pasos", "type": "max_steps", "value": 8, "label": "Como mucho 8 steps" }
  ],
  "rubric": [
    { "check": "runs", "points": 1 },
    { "check": "columns", "points": 2 },
    { "check": "row_count", "points": 1 },
    { "check": "values", "points": 4 },
    { "check": "rule:usa_group_by", "points": 1, "requires": ["runs"] },
    { "check": "rule:sin_codigo", "points": 0.5 },
    { "check": "rule:max_pasos", "points": 0.5 }
  ],
  "scale": 10,
  "policy": {
    "allow_steps": [],
    "unknown_steps": "block",
    "timeout_s": 15,
    "max_rows": 100000,
    "max_output_mb": 5,
    "locale": "es_ES",
    "timezone": "Europe/Madrid",
    "encoding": "UTF-8"
  }
}
