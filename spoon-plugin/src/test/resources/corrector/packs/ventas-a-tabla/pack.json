    "database": { "template": "plantilla/dw.sqlite", "type": "SQLITE" },
    "sql": "SELECT producto, unidades, ROUND(importe_total, 2) AS importe_total, num_ventas, ROUND(importe_medio, 2) AS importe_medio, date(ultima_venta / 1000, 'unixepoch') AS ultima_venta FROM totales"
  },
  "compare": {
    "key_columns": ["producto"],
    "numeric_tolerance": 0.01,
    "max_examples": 5
  },
