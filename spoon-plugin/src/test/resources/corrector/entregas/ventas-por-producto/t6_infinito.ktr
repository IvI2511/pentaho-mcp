<?xml version="1.0" encoding="UTF-8"?>
<transformation>
  <info>
    <name>03_ventas_por_producto</name>
    <description>CSV input -> Calculator -> Sort rows -> Group by -> Text file output</description>
    <extended_description>Lee datos/ventas.csv, calcula importe = cantidad * precio_unitario, ordena por producto y agrega por producto (suma, cuenta, promedio, maximo). Group by exige la entrada ordenada por las claves de grupo.</extended_description>
    <trans_version/>
    <trans_type>Normal</trans_type>
    <directory>/</directory>
    <parameters>
    </parameters>
    <size_rowset>10000</size_rowset>
    <sleep_time_empty>50</sleep_time_empty>
    <sleep_time_full>50</sleep_time_full>
    <unique_connections>N</unique_connections>
    <feedback_shown>Y</feedback_shown>
    <feedback_size>50000</feedback_size>
    <using_thread_priorities>Y</using_thread_priorities>
    <shared_objects_file/>
    <capture_step_performance>N</capture_step_performance>
    <step_performance_capturing_delay>1000</step_performance_capturing_delay>
    <step_performance_capturing_size_limit>100</step_performance_capturing_size_limit>
    <dependencies>
    </dependencies>
    <partitionschemas>
    </partitionschemas>
    <slaveservers>
    </slaveservers>
    <clusterschemas>
    </clusterschemas>
    <created_user>-</created_user>
    <created_date>2026/10/20 10:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/10/20 10:00:00.000</modified_date>
    <key_for_session_key/>
    <is_key_private>N</is_key_private>
  </info>
  <notepads>
  </notepads>
  <order><hop><from>Generar</from><to>Escribir totales</to><enabled>Y</enabled></hop></order>
  <step>
    <name>Generar</name>
    <type>RowGenerator</type>
    <description/><distribute>Y</distribute><custom_distribution/><copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <fields><field><name>producto</name><type>String</type><format></format><currency/><decimal>.</decimal><group/><nullif>Café</nullif><length>-1</length><precision>-1</precision><set_empty_string>N</set_empty_string></field><field><name>unidades</name><type>Integer</type><format>#</format><currency/><decimal>.</decimal><group/><nullif>1</nullif><length>-1</length><precision>-1</precision><set_empty_string>N</set_empty_string></field><field><name>importe_total</name><type>Number</type><format>#.##</format><currency/><decimal>.</decimal><group/><nullif>1.0</nullif><length>-1</length><precision>-1</precision><set_empty_string>N</set_empty_string></field><field><name>num_ventas</name><type>Integer</type><format>#</format><currency/><decimal>.</decimal><group/><nullif>1</nullif><length>-1</length><precision>-1</precision><set_empty_string>N</set_empty_string></field><field><name>importe_medio</name><type>Number</type><format>#.##</format><currency/><decimal>.</decimal><group/><nullif>1.0</nullif><length>-1</length><precision>-1</precision><set_empty_string>N</set_empty_string></field><field><name>ultima_venta</name><type>Date</type><format>yyyy-MM-dd</format><currency/><decimal>.</decimal><group/><nullif>2024-05-01</nullif><length>-1</length><precision>-1</precision><set_empty_string>N</set_empty_string></field></fields>
    <limit>10</limit>
    <never_ending>Y</never_ending>
    <interval_in_ms>0</interval_in_ms>
    <row_time_field>now</row_time_field>
    <last_time_field>FiveSecondsAgo</last_time_field>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>80</xloc><yloc>80</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>Escribir totales</name>
    <type>TextFileOutput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <separator>;</separator>
    <enclosure>"</enclosure>
    <enclosure_forced>N</enclosure_forced>
    <enclosure_fix_disabled>N</enclosure_fix_disabled>
    <header>Y</header>
    <footer>N</footer>
    <format>UNIX</format>
    <compression>None</compression>
    <encoding>UTF-8</encoding>
    <endedLine/>
    <fileNameInField>N</fileNameInField>
    <fileNameField/>
    <create_parent_folder>Y</create_parent_folder>
    <file>
      <name>C:\Users\ana\Escritorio\PDI\resultado</name>
      <servlet_output>N</servlet_output>
      <do_not_open_new_file_init>Y</do_not_open_new_file_init>
      <extention>csv</extention>
      <append>N</append>
      <split>N</split>
      <haspartno>N</haspartno>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <SpecifyFormat>N</SpecifyFormat>
      <date_time_format/>
      <add_to_result_filenames>Y</add_to_result_filenames>
      <pad>N</pad>
      <fast_dump>N</fast_dump>
      <splitevery>0</splitevery>
    </file>
    <fields>
      <field>
        <name>producto</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <nullif/>
        <trim_type>none</trim_type>
        <length>-1</length>
        <precision>-1</precision>
      </field>
      <field>
        <name>unidades</name>
        <type>Integer</type>
        <format>0</format>
        <currency/>
        <decimal/>
        <group/>
        <nullif/>
        <trim_type>none</trim_type>
        <length>-1</length>
        <precision>-1</precision>
      </field>
      <field>
        <name>importe_total</name>
        <type>Number</type>
        <format>0.00</format>
        <currency/>
        <decimal>.</decimal>
        <group/>
        <nullif/>
        <trim_type>none</trim_type>
        <length>-1</length>
        <precision>-1</precision>
      </field>
      <field>
        <name>num_ventas</name>
        <type>Integer</type>
        <format>0</format>
        <currency/>
        <decimal/>
        <group/>
        <nullif/>
        <trim_type>none</trim_type>
        <length>-1</length>
        <precision>-1</precision>
      </field>
      <field>
        <name>importe_medio</name>
        <type>Number</type>
        <format>0.00</format>
        <currency/>
        <decimal>.</decimal>
        <group/>
        <nullif/>
        <trim_type>none</trim_type>
        <length>-1</length>
        <precision>-1</precision>
      </field>
      <field>
        <name>ultima_venta</name>
        <type>Date</type>
        <format>yyyy-MM-dd</format>
        <currency/>
        <decimal/>
        <group/>
        <nullif/>
        <trim_type>none</trim_type>
        <length>-1</length>
        <precision>-1</precision>
      </field>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>736</xloc>
      <yloc>112</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step_error_handling>
  </step_error_handling>
  <slave-step-copy-partition-distribution>
  </slave-step-copy-partition-distribution>
  <slave_transformation>N</slave_transformation>
  <attributes/>
</transformation>
