# Compilados del plugin
spoon-plugin/build/
spoon-plugin/dist/
*.class

# Salidas de los ejemplos al correrlos con Pan/Kitchen
claude/skills/pentaho-etl/manual/ejemplos/salida/
# Bases SQLite, rechazos y logs de los patrones (verificar.ps1 / verificar.sh)
claude/skills/pentaho-etl/patrones/*/salida/
# Cache del linter de Python (lo crea ruff al chequear verificar.py)
.ruff_cache/

# Generador del catalogo
tools/generador-catalogo/build/

spoon-plugin/.ruff_cache/

# Instalador de Windows: lo que arma instalador/preparar.ps1 (staging y cache del JRE) y lo que
# compila Inno Setup. Se versionan los scripts, el lanzador, las letras y pentaho-live.ico.
instalador/staging/
instalador/cache/
instalador/*.exe

# Salida del ejemplo Grano de Oro (almacén SQLite, rechazos y KPI): se regenera con el job
ejemplo/salida/
