<?xml version="1.0" encoding="UTF-8"?>
<job>
  <name>01_csv_a_staging</name>
  <description>Creates the staging table if it does not exist and loads datos/clientes.csv into it</description>
  <extended_description>Pattern 01, entry point. START -&gt; create salida/ -&gt; CREATE TABLE IF NOT EXISTS -&gt; 01_csv_a_staging.ktr -&gt; Success. Any failure goes to Abort, so Kitchen ends with exit 1.</extended_description>
