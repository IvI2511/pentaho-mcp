<?xml version="1.0" encoding="UTF-8"?>
<job>
  <name>03_carga_incremental</name>
  <description>Incremental load by date: loads only the source rows changed since the last run and moves the watermark</description>
  <extended_description>Pattern 03, entry point. Control table etl_control keeps the last updated_at loaded. 03a reads it (LAST_WM) and the current source maximum (NEW_WM); 03b loads the window (LAST_WM, NEW_WM]; only if that worked, the SQL entry stores NEW_WM. A failed load leaves the watermark where it was, so the next run retries the same window. Running it twice with no new data loads 0 rows.</extended_description>
  <job_version/>
  <job_status>0</job_status>
  <directory>/</directory>
  <created_user>-</created_user>
  <created_date>2026/10/20 10:00:00.000</created_date>
