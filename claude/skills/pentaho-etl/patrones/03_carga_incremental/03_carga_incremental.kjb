      <fail_of_folder_exists>N</fail_of_folder_exists>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>256</xloc>
      <yloc>112</yloc>
      <attributes_kjc/>
    </entry>
    <entry>
      <name>Create DWH tables</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>CREATE TABLE IF NOT EXISTS etl_control (&#xa;  table_name      VARCHAR(64) PRIMARY KEY,&#xa;  last_watermark  VARCHAR(19) NOT NULL,&#xa;  last_run        VARCHAR(19)&#xa;);&#xa;INSERT INTO etl_control (table_name, last_watermark)&#xa;SELECT 'orders', '1900-01-01 00:00:00'&#xa;WHERE NOT EXISTS (SELECT 1 FROM etl_control WHERE table_name = 'orders');&#xa;CREATE TABLE IF NOT EXISTS stg_orders (&#xa;  order_id     INTEGER PRIMARY KEY,&#xa;  customer_id  INTEGER,&#xa;  order_date   VARCHAR(10),&#xa;  amount       NUMERIC(12,2),&#xa;  status       VARCHAR(20),&#xa;  updated_at   VARCHAR(19) NOT NULL&#xa;);</sql>
      <useVariableSubstitution>F</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>F</sendOneStatement>
      <connection>dwh</connection>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>416</xloc>
      <yloc>112</yloc>
      <attributes_kjc/>
    </entry>
