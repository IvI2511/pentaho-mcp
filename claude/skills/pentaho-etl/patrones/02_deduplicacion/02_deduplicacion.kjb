      <sql>CREATE TABLE IF NOT EXISTS customers_latest (&#xa;  customer_id   INTEGER PRIMARY KEY,&#xa;  name          VARCHAR(100),&#xa;  email         VARCHAR(150),&#xa;  city          VARCHAR(60),&#xa;  updated_at    TIMESTAMP,&#xa;  copies_found  INTEGER&#xa;);&#xa;CREATE TABLE IF NOT EXISTS customers_first_seen (&#xa;  customer_id   INTEGER PRIMARY KEY,&#xa;  name          VARCHAR(100),&#xa;  email         VARCHAR(150),&#xa;  city          VARCHAR(60),&#xa;  updated_at    TIMESTAMP&#xa;);</sql>
