<?xml version="1.0" encoding="UTF-8"?>
<job>
  <name>02_deduplicacion</name>
  <description>Runs both deduplication variants over datos/clientes_duplicados.csv</description>
  <extended_description>Pattern 02, entry point. Creates the two target tables if needed, then runs 02a (Sort rows + Unique rows: newest row per key) and 02b (Unique rows HashSet: first row per key). Compare customers_latest and customers_first_seen to see the difference.</extended_description>
