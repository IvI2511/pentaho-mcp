<?xml version="1.0" encoding="UTF-8"?>
<job>
  <name>04_scd_tipo2</name>
  <description>Creates dim_customer if needed and applies the snapshot ${ARCHIVO_CLIENTES} valid from ${FECHA_CARGA}</description>
  <extended_description>Pattern 04, entry point. Run it with the day-1 snapshot, then with ARCHIVO_CLIENTES=clientes_dia2.csv and FECHA_CARGA=2026-10-15: customer 3 (city changed) gets a second version and the first one is closed; customer 2 (email fixed) keeps one version; customer 6 is new.</extended_description>
  <job_version/>
  <job_status>0</job_status>
  <directory>/</directory>
  <created_user>-</created_user>
  <created_date>2026/10/20 10:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/10/20 10:00:00.000</modified_date>
  <parameters>
    <parameter>
      <name>ARCHIVO_CLIENTES</name>
      <default_value>clientes_dia1.csv</default_value>
      <description>Customer snapshot to load, inside datos/</description>
    </parameter>
    <parameter>
      <name>FECHA_CARGA</name>
      <default_value>2026-10-01</default_value>
      <description>Date the snapshot is valid from (yyyy-MM-dd): closes old versions</description>
    </parameter>
  </parameters>
  <connection>
    <name>dwh</name>
    <server/>
    <type>SQLITE</type>
    <access>Native</access>
    <database>${Internal.Entry.Current.Directory}/salida/04_dwh.sqlite</database>
    <port>-1</port>
    <username/>
