      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>96</xloc>
      <yloc>112</yloc>
      <attributes_kjc/>
    </entry>
    <entry>
      <name>Create output folder</name>
      <description/>
      <type>CREATE_FOLDER</type>
      <attributes/>
