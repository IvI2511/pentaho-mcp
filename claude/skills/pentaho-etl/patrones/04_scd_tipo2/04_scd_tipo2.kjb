      <xloc>256</xloc>
      <yloc>112</yloc>
      <attributes_kjc/>
    </entry>
    <entry>
      <name>Create dimension table</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>CREATE TABLE IF NOT EXISTS dim_customer (&#xa;  customer_sk  INTEGER PRIMARY KEY AUTOINCREMENT,&#xa;  version      INTEGER,&#xa;  valid_from   TIMESTAMP,&#xa;  valid_to     TIMESTAMP,&#xa;  customer_id  INTEGER,&#xa;  name         VARCHAR(100),&#xa;  email        VARCHAR(150),&#xa;  city         VARCHAR(60),&#xa;  segment      VARCHAR(20)&#xa;);&#xa;CREATE INDEX IF NOT EXISTS idx_dim_customer_lookup ON dim_customer (customer_id, valid_from, valid_to);</sql>
      <useVariableSubstitution>F</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>F</sendOneStatement>
      <connection>dwh</connection>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>416</xloc>
      <yloc>112</yloc>
