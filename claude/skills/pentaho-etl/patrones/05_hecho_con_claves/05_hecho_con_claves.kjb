      <nr>0</nr>
      <xloc>256</xloc>
      <yloc>112</yloc>
      <attributes_kjc/>
    </entry>
    <entry>
      <name>Create star schema</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>CREATE TABLE IF NOT EXISTS dim_customer (&#xa;  customer_sk   INTEGER PRIMARY KEY,&#xa;  customer_id   INTEGER NOT NULL,&#xa;  name          VARCHAR(100),&#xa;  city          VARCHAR(60)&#xa;);&#xa;CREATE TABLE IF NOT EXISTS dim_product (&#xa;  product_sk    INTEGER PRIMARY KEY,&#xa;  product_code  VARCHAR(20) NOT NULL,&#xa;  product_name  VARCHAR(100),&#xa;  category      VARCHAR(40)&#xa;);&#xa;CREATE TABLE IF NOT EXISTS fact_sales (&#xa;  sale_id       INTEGER PRIMARY KEY,&#xa;  sale_date     DATE,&#xa;  customer_sk   INTEGER NOT NULL,&#xa;  product_sk    INTEGER NOT NULL,&#xa;  quantity      INTEGER,&#xa;  unit_price    NUMERIC(12,2),&#xa;  amount        NUMERIC(12,2)&#xa;);&#xa;INSERT INTO dim_customer (customer_sk, customer_id, name, city)&#xa;SELECT 0, -1, 'Unknown', 'Unknown'&#xa;WHERE NOT EXISTS (SELECT 1 FROM dim_customer WHERE customer_sk = 0);&#xa;INSERT INTO dim_product (product_sk, product_code, product_name, category)&#xa;SELECT 0, 'N/A', 'Unknown', 'Unknown'&#xa;WHERE NOT EXISTS (SELECT 1 FROM dim_product WHERE product_sk = 0);</sql>
      <useVariableSubstitution>F</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>F</sendOneStatement>
      <connection>dwh</connection>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>416</xloc>
      <yloc>112</yloc>
      <attributes_kjc/>
    </entry>
    <entry>
      <name>Seed demo dimensions</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>DELETE FROM dim_customer WHERE customer_sk &gt; 0;&#xa;INSERT INTO dim_customer (customer_sk, customer_id, name, city) VALUES&#xa;  (11, 1, 'Ana Pérez', 'Madrid'),&#xa;  (12, 2, 'Bruno Díaz', 'Sevilla'),&#xa;  (13, 3, 'Carla Núñez', 'Valencia'),&#xa;  (14, 4, 'Diego Ruiz', 'Bilbao');&#xa;DELETE FROM dim_product WHERE product_sk &gt; 0;&#xa;INSERT INTO dim_product (product_sk, product_code, product_name, category) VALUES&#xa;  (21, 'P-100', 'Café molido 250 g', 'Café'),&#xa;  (22, 'P-200', 'Té verde 20 bolsitas', 'Té'),&#xa;  (23, 'P-300', 'Taza de cerámica', 'Accesorios'),&#xa;  (24, 'P-400', 'Filtros de papel x100', 'Accesorios');</sql>
      <useVariableSubstitution>F</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>F</sendOneStatement>
      <connection>dwh</connection>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>576</xloc>
      <yloc>112</yloc>
      <attributes_kjc/>
    </entry>
    <entry>
