<?xml version="1.0" encoding="UTF-8"?>
<job>
  <name>05_hecho_con_claves</name>
  <description>Creates the star schema (with the Unknown members), seeds two small dimensions and loads sales batch ${LOTE}</description>
  <extended_description>Pattern 05, entry point. 'Seed demo dimensions' is scaffolding: in a real project the dimensions have their own ETL (pattern 04) and run before the facts. Run with LOTE=1, then LOTE=2: sale 5003 is corrected (updated, not duplicated) and two new sales are added.</extended_description>
  <job_version/>
  <job_status>0</job_status>
  <directory>/</directory>
  <created_user>-</created_user>
  <created_date>2026/10/20 10:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/10/20 10:00:00.000</modified_date>
  <parameters>
    <parameter>
      <name>LOTE</name>
      <default_value>1</default_value>
      <description>Batch of sales to load (1 or 2)</description>
    </parameter>
  </parameters>
  <connection>
